# ── Environment: DEV (optional) ──────────────────────────────────────────────────
# The pipelines deploy acc and prod. Use this only after adding a dev environment to them
# (README: "Adding a DEV environment"). DEV is where Git integration is usually switched on.
# Ids only, never secrets: this file is committed and read by the pipeline.

tenant_id                    = "00000000-0000-0000-0000-000000000000" # your Entra tenant id
workspace_environment_suffix = "DEV"
create_domains               = false # acc keeps creating the domains (its state owns them); dev looks them up

# Capacity (created by Terraform; resumed before every run if it is paused)
create_capacity          = true
capacity_name            = "mycompanyfabricdev" # 3-63 lowercase letters/digits, unique per region
capacity_sku             = "F2"
capacity_resource_group  = "rg-fabricvending-capacity"
capacity_location        = "westeurope"
capacity_admin_email     = "admin@yourtenant.onmicrosoft.com" # UPN of a native member; no guests, no #EXT#
capacity_subscription_id = "00000000-0000-0000-0000-000000000000"
capacity_extra_admins    = ["00000000-0000-0000-0000-000000000000"] # pipeline service principal object id
# capacity_auto_pause    = true # opt-in: pause after every plan/apply

workspace_admin_user_object_ids = [
  "00000000-0000-0000-0000-000000000000",
]

# Needed when a workspace has git_integration = true: the id of a Fabric Git connection
# (Fabric > Settings > Manage connections and gateways).
# git_connection_id = "00000000-0000-0000-0000-000000000000"

# Optional: an existing Entra group nested into each workspace Admin group
# owner_group_display_name = "Fabric Admins"
